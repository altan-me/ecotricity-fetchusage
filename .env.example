# Ecotricity Login Credentials
# Copy this file to .env and fill in your actual credentials
ECOTRICITY_LOGIN=your_account_number
ECOTRICITY_PASSWORD=your_password

# Scheduler Configuration (optional, defaults to 11 PM)
SCHEDULER_HOUR=23
SCHEDULER_MINUTE=0

# Docker-specific configuration (optional)
# When running in Docker, these configure the web server
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
